{
  "name": "dsh-session-temp-reaper",
  "version": "0.1.0",
  "type": "module",
  "description": "Adds a composer button that lists the files this session created and deletes the ones the user does not keep.",
  "license": "MIT",
  "author": "liyolin <liyolin@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liyolin/dsh-session-temp-reaper.git"
  },
  "homepage": "https://github.com/liyolin/dsh-session-temp-reaper#readme",
  "bugs": {
    "url": "https://github.com/liyolin/dsh-session-temp-reaper/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cleanup",
    "temporary-files"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
